{
  "optionTypeForm": {
    "name": "Release Demo",
    "code": "release-demo",
    "description": "Order form of the Release Demo Helm catalog item",
    "options": [
      {
        "fieldName": "appName",
        "fieldLabel": "App Name",
        "fieldContext": "config.customOptions",
        "type": "text",
        "required": true,
        "placeHolder": "release-demo",
        "helpBlock": "Lowercase letters, digits and dashes. Used as the app name and the Helm release name.",
        "verifyPattern": "^[a-z][a-z0-9-]{1,30}$",
        "displayOrder": 0
      },
      {
        "fieldName": "cluster",
        "fieldLabel": "Kubernetes Cluster",
        "fieldContext": "config.customOptions",
        "type": "select",
        "required": true,
        "displayOrder": 1,
        "optionSource": "list",
        "optionList": {
          "id": 20
        }
      },
      {
        "fieldName": "environment",
        "fieldLabel": "Environment",
        "fieldContext": "config.customOptions",
        "type": "select",
        "required": true,
        "defaultValue": "dev",
        "displayOrder": 2,
        "optionSource": "list",
        "optionList": {
          "id": 21
        }
      },
      {
        "fieldName": "namespace",
        "fieldLabel": "Namespace",
        "fieldContext": "config.customOptions",
        "type": "select",
        "required": true,
        "helpBlock": "Namespaces of the selected cluster you may use.",
        "displayOrder": 3,
        "optionSource": "list",
        "dependsOnCode": "cluster",
        "optionList": {
          "id": 18
        }
      },
      {
        "fieldName": "nodePort",
        "fieldLabel": "NodePort",
        "fieldContext": "config.customOptions",
        "type": "text",
        "required": true,
        "defaultValue": "31200",
        "helpBlock": "30000-32767, free on the cluster. App URL: http://apps.hpetrlab.local:<NodePort>",
        "verifyPattern": "^(30[0-9]{3}|31[0-9]{3}|32[0-6][0-9]{2}|327[0-5][0-9]|3276[0-7])$",
        "displayOrder": 4
      },
      {
        "fieldName": "replicas",
        "fieldLabel": "Replicas",
        "fieldContext": "config.customOptions",
        "type": "text",
        "required": true,
        "defaultValue": "3",
        "helpBlock": "Number of pods, 1-5.",
        "verifyPattern": "^[1-5]$",
        "displayOrder": 5
      }
    ]
  }
}
