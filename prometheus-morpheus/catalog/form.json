{
 "optionTypeForm": {
  "name": "Prometheus",
  "code": "prometheus",
  "description": "Order form of the Prometheus catalog item",
  "options": [
   {
    "fieldName": "appName",
    "fieldLabel": "App Name",
    "fieldContext": "config.customOptions",
    "type": "text",
    "required": true,
    "placeHolder": "prometheus",
    "verifyPattern": "^[a-z][a-z0-9-]{1,30}$",
    "helpBlock": "Lowercase letters, digits and dashes. Used as the app name and the Helm release name.",
    "displayOrder": 0
   },
   {
    "fieldName": "group",
    "fieldLabel": "Group",
    "fieldContext": "config.customOptions",
    "type": "select",
    "required": true,
    "optionSource": "list",
    "optionList": {
     "id": 24
    },
    "helpBlock": "Morpheus group the app belongs to.",
    "displayOrder": 1
   },
   {
    "fieldName": "cluster",
    "fieldLabel": "Kubernetes Cluster",
    "fieldContext": "config.customOptions",
    "type": "select",
    "required": true,
    "optionSource": "list",
    "optionList": {
     "id": 20
    },
    "displayOrder": 2
   },
   {
    "fieldName": "environment",
    "fieldLabel": "Environment",
    "fieldContext": "config.customOptions",
    "type": "select",
    "required": true,
    "defaultValue": "dev",
    "optionSource": "list",
    "optionList": {
     "id": 21
    },
    "displayOrder": 3
   },
   {
    "fieldName": "namespace",
    "fieldLabel": "Namespace",
    "fieldContext": "config.customOptions",
    "type": "select",
    "required": true,
    "optionSource": "list",
    "optionList": {
     "id": 18
    },
    "dependsOnCode": "cluster",
    "helpBlock": "Namespaces of the selected cluster you may use.",
    "displayOrder": 4
   },
   {
    "fieldName": "publicHost",
    "fieldLabel": "Public Address",
    "fieldContext": "config.customOptions",
    "type": "text",
    "required": true,
    "defaultValue": "apps.hpetrlab.local",
    "verifyPattern": "^[A-Za-z0-9.-]+$",
    "helpBlock": "Host name or IP users open Prometheus with: a load balancer name, or any Kubernetes node IP. The URL becomes http://<Public Address>:<NodePort>.",
    "displayOrder": 5
   },
   {
    "fieldName": "nodePort",
    "fieldLabel": "NodePort",
    "fieldContext": "config.customOptions",
    "type": "text",
    "required": true,
    "defaultValue": "31390",
    "verifyPattern": "^(30[0-9]{3}|31[0-9]{3}|32[0-6][0-9]{2}|327[0-5][0-9]|3276[0-7])$",
    "helpBlock": "30000-32767, free on the cluster.",
    "displayOrder": 6
   },
   {
    "fieldName": "storageClass",
    "fieldLabel": "Storage Class",
    "fieldContext": "config.customOptions",
    "type": "select",
    "required": true,
    "optionSource": "list",
    "optionList": {
     "id": 19
    },
    "dependsOnCode": "cluster",
    "helpBlock": "Where Prometheus keeps its time series data.",
    "displayOrder": 7
   },
   {
    "fieldName": "storageSize",
    "fieldLabel": "Storage Size (GB)",
    "fieldContext": "config.customOptions",
    "type": "text",
    "required": true,
    "defaultValue": "10",
    "verifyPattern": "^([1-9]|[1-9][0-9]|1[0-9][0-9]|200)$",
    "helpBlock": "1-200 GB.",
    "displayOrder": 8
   },
   {
    "fieldName": "retentionDays",
    "fieldLabel": "Retention (days)",
    "fieldContext": "config.customOptions",
    "type": "text",
    "required": true,
    "defaultValue": "30",
    "verifyPattern": "^([1-9]|[1-9][0-9]|[1-3][0-9][0-9])$",
    "helpBlock": "1-399 days of data Prometheus keeps.",
    "displayOrder": 9
   },
   {
    "fieldName": "hostAddresses",
    "fieldLabel": "HVM Host Addresses",
    "fieldContext": "config.customOptions",
    "type": "text",
    "required": false,
    "placeHolder": "10.0.0.11,10.0.0.12",
    "verifyPattern": "^[A-Za-z0-9.:\\-]+(\\s*,\\s*[A-Za-z0-9.:\\-]+)*$|^$",
    "helpBlock": "Comma-separated addresses of the HVM hosts that run node_exporter (9100) and prometheus-libvirt-exporter (9177). Empty = no host metrics.",
    "displayOrder": 10
   },
   {
    "fieldName": "hostSource",
    "fieldLabel": "Environment Label",
    "fieldContext": "config.customOptions",
    "type": "text",
    "required": false,
    "placeHolder": "vme",
    "verifyPattern": "^[a-z0-9-]{0,30}$",
    "helpBlock": "Value of the 'source' label on the host metrics (e.g. vme, enterprise). The HVM dashboards show it as Environment. Empty = hvm.",
    "displayOrder": 11
   },
   {
    "fieldName": "morpheusScrape",
    "fieldLabel": "Collect Morpheus VM stats",
    "fieldContext": "config.customOptions",
    "type": "checkbox",
    "required": false,
    "defaultValue": "off",
    "helpBlock": "Adds a json-exporter that reads /api/servers of a Morpheus or VM Essentials manager and keeps per-server CPU, memory, disk and network as time series.",
    "displayOrder": 12
   },
   {
    "fieldName": "morpheusUrl",
    "fieldLabel": "Morpheus URL",
    "fieldContext": "config.customOptions",
    "type": "text",
    "required": false,
    "placeHolder": "https://morpheus.example.com",
    "verifyPattern": "^(https?://[A-Za-z0-9.:-]+/?)?$",
    "helpBlock": "Only when the box above is ticked. Base URL of the Morpheus or VM Essentials manager to read.",
    "displayOrder": 13
   },
   {
    "fieldName": "morpheusToken",
    "fieldLabel": "Morpheus API Token",
    "fieldContext": "config.customOptions",
    "type": "password",
    "required": false,
    "verifyPattern": "^[A-Za-z0-9-]*$",
    "helpBlock": "Only when the box above is ticked. Token of a read-only user with Compute = Read.",
    "displayOrder": 14
   },
   {
    "fieldName": "morpheusName",
    "fieldLabel": "Source Label",
    "fieldContext": "config.customOptions",
    "type": "text",
    "required": false,
    "defaultValue": "morpheus",
    "verifyPattern": "^[a-z0-9-]{1,30}$",
    "helpBlock": "Value of the 'morpheus' label on the metrics, to tell sources apart.",
    "displayOrder": 15
   }
  ]
 }
}
